<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HostileFileDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\Sandbox\SandboxClient.cs" Link="Sandbox\SandboxClient.cs" />
    <!-- The parser runs INSIDE the sandbox, never in this process: ship it as content. -->
    <None Include="..\parser\parser.cs" Link="parser\parser.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
